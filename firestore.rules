rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(me()) ? get(me()).data.role : ''; }
    function isSuper() { return signedIn() && role() == 'super'; }
    function isAdmin() { return signedIn() && role() in ['super', 'admin']; }
    function isMember() { return signedIn() && exists(me()); }
    function ownerPath() { return /databases/$(database)/documents/meta/owner; }

    // 첫 슈퍼관리자 등록 (한 번만 가능)
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && !exists(ownerPath())
        && request.resource.data.uid == request.auth.uid
        && existsAfter(me());
    }

    // 로그인 계정과 권한
    match /users/{uid} {
      allow read: if isMember();
      allow create: if isSuper()
        || (signedIn() && request.auth.uid == uid && !exists(ownerPath())
            && existsAfter(ownerPath()) && request.resource.data.role == 'super');
      allow update, delete: if isSuper();
    }

    // 경력 기록: 관리자만 읽기, 슈퍼관리자만 쓰기
    match /careers/{id} {
      allow read: if isAdmin();
      allow write: if isSuper();
    }

    // 인원·설정·대직·편성·계획표: 로그인한 인원은 읽기, 슈퍼관리자만 쓰기
    match /members/{id} {
      allow read: if isMember();
      allow write: if isSuper();
    }
    match /config/{id} {
      allow read: if isMember();
      allow write: if isSuper();
    }
    match /duties/{id} {
      allow read: if isMember();
      allow write: if isSuper();
    }
    match /assign/{id} {
      allow read: if isMember();
      allow write: if isSuper();
    }
    match /plans/{id} {
      allow read: if isMember();
      allow write: if isSuper();
    }
  }
}
